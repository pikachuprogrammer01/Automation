#!/bin/zsh
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
case "${1:-}" in
  -h|--help|help)
    printf '%s\n' '用法：manager/run-recorded-task <任务 ID>' '' \
      '跑 tasks/<任务 ID>/recorded.spec.js（Playwright，依赖取自 manager/node_modules）。' \
      '任务 ID 由管理器登记，见 var/registry.json。' '' \
      '退出码：2 参数不合法 · 3 缺 playwright CLI · 4 找不到 node · 5 找不到脚本 · 其余为 Playwright 退出码' \
      '输出：追加写 logs/<任务 ID>.log，本脚本不往 stdout 打东西。'
    exit 0 ;;
esac
ID="${1:-}"
if [[ ! "$ID" =~ '^[a-z0-9][a-z0-9-]{1,40}$' ]]; then
  printf '用法：manager/run-recorded-task <任务 ID>\n任务 ID 缺失或不合法：%s（只允许小写字母、数字和连字符，2-41 位）\n' "${ID:-（空）}" >&2
  exit 2
fi
# 数据根 = 仓根的 var/；AUTOMATION_HOME 可整体改指向。
BASE="${AUTOMATION_HOME:-${0:A:h:h}/var}"
TASK="$BASE/tasks/$ID"
LOG="$BASE/logs/$ID.log"
LOCK="$TASK/.lock"
mkdir -p "$BASE/logs"
source "${0:A:h}/../lib/automation-run.zsh"
run_ctx_init "" "$ID"
RECORD="${0:A:h}/run-record.mjs"
RUNNER_RESULT=""
# 所有出口都过这里：先落运行记录，再按原退出码退出。观测层不改退出码。
finish() {
  run_record "${NODE:-}" "$RECORD" "$1"
  exit "$1"
}
# 先确认脚本在，再拿锁：否则任务目录缺失会被 mkdir 判成“拿不到锁”，报成 already_running 并 0 退出。
if [[ ! -f "$TASK/recorded.spec.js" ]]; then
  printf '%s {"status":"failed","reason":"script_not_found","task":"%s"}\n' "$(date '+%F %T')" "$ID" >> "$LOG"
  RUNNER_RESULT="{\"status\":\"failed\",\"reason\":\"script_not_found\",\"note\":\"$TASK/recorded.spec.js 不存在\"}"
  finish 5
fi
if ! acquire_lock "$LOCK"; then
  printf '%s {"status":"skipped","reason":"already_running"}\n' "$(date '+%F %T')" >> "$LOG"
  RUNNER_RESULT='{"status":"skipped","reason":"already_running"}'
  finish 0
fi
trap 'release_lock "$LOCK"' EXIT
if [[ "$LOCK_STALE" == 1 ]]; then
  printf '%s {"status":"warn","reason":"lock_stale","note":"上一轮遗留的锁已接管（多半是被强杀）"}\n' "$(date '+%F %T')" >> "$LOG"
fi

# playwright CLI 的 shebang 是 `#!/usr/bin/env node`，而这里的 PATH 故意不含 nvm 目录，
# 直接执行会 127。所以显式解析一个 node：管理器传入 > nvm 最新版 > Homebrew > /usr/local > PATH。
resolve_node
if [[ -z "$NODE" ]]; then
  printf '%s {"status":"failed","reason":"node_not_found"}\n' "$(date '+%F %T')" >> "$LOG"
  exit 4   # 没有 node 就发不出运行记录，这条只能留在日志里
fi

RUNNER="${0:A:h}/node_modules/.bin/playwright"
if [[ ! -x "$RUNNER" ]]; then
  printf '%s {"status":"failed","reason":"playwright_cli_missing"}\n' "$(date '+%F %T')" >> "$LOG"
  RUNNER_RESULT='{"status":"failed","reason":"playwright_cli_missing","note":"先在 manager 下 npm install 装 @playwright/test"}'
  finish 3
fi

# 任务目录在 manager/ 之外，Node 从 config/spec 向上找不到 @playwright/test。
# 用一层 tasks/node_modules 软链把引擎的依赖接上，只建一次。
# 依赖位置用 ${0:A:h}（本脚本所在的 manager/）而不是 $BASE/manager：数据根可以被
# AUTOMATION_HOME 搬到任何地方，引擎跟着搬就找不到依赖了。
mkdir -p "$BASE/tasks"
if [[ -L "$BASE/tasks/node_modules" && ! -e "$BASE/tasks/node_modules" ]]; then
  rm -f "$BASE/tasks/node_modules"   # 目录被搬走后留下的悬空软链，重建前先清掉
fi
[[ -e "$BASE/tasks/node_modules" ]] || ln -s "${0:A:h}/node_modules" "$BASE/tasks/node_modules"

cd "$TASK" || exit 2
printf '%s START node=%s\n' "$(date '+%F %T')" "$("$NODE" -v 2>/dev/null || echo unknown)" >> "$LOG"
"$NODE" "$RUNNER" test recorded.spec.js --config playwright.config.mjs >> "$LOG" 2>&1
RC=$?
printf '%s EXIT=%s\n' "$(date '+%F %T')" "$RC" >> "$LOG"
# 录制任务是用户自己的 Playwright 脚本，没有站点语义可报：状态看退出码，
# note 取日志最后一行，证据由 Playwright 自己的 test-results/ 截图承担。
LAST=$(tail -1 "$LOG" 2>/dev/null | cut -c1-200)
if (( RC == 0 )); then
  RUNNER_RESULT="{\"status\":\"completed\",\"note\":\"$LAST\"}"
else
  RUNNER_RESULT="{\"status\":\"failed\",\"reason\":\"playwright_failed\",\"note\":\"$LAST\"}"
fi
finish "$RC"
